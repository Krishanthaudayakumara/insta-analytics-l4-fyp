def extract_post_data(file_path):
    """Extracts data from a .info file, handling missing data."""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            post_data = json.load(f)

        extracted = {
            'post_id': post_data['id'],
            'owner_id': post_data['owner']['id'],
            'timestamp': post_data['taken_at_timestamp'],
            'likes': post_data['edge_media_preview_like']['count'],
            'comments_count': post_data.get('edge_media_to_parent_comment', {}).get('count', 0),
            'comments': [],
            'caption': "",
            'hashtags': [],
            'location_id': post_data['location']['id'] if post_data.get('location') else None
        }

        if post_data.get('edge_media_to_caption') and post_data['edge_media_to_caption']['edges']:
            extracted['caption'] = post_data['edge_media_to_caption']['edges'][0]['node']['text']
            extracted['hashtags'] = [match.group(0)[1:] for match in re.finditer(r"#[\w-]+", extracted['caption'])]

        if post_data.get('edge_media_to_parent_comment') and post_data['edge_media_to_parent_comment']['edges']:
            for comment in post_data['edge_media_to_parent_comment']['edges']:
                extracted['comments'].append({
                    'comment_text': comment['node']['text'],
                    'comment_created_at': comment['node']['created_at'],
                    'comment_owner_username': comment['node']['owner']['username'],
                    'comment_likes': comment['node']['edge_liked_by']['count']
                })

    except (FileNotFoundError, json.JSONDecodeError) as e:
        logging.error(f"Error processing file {file_path}: {e}")
        return None

    return extracted


def process_all_data(clustered_data_path, influencers_csv_path, max_users=None, chunk_size=1000):
    """Processes data, merging by username, handling mismatches, with user limit, chunking, logging, progress bars, and empty DataFrame checks."""
    logging.info("Starting data processing")

    try:
        influencers_df = pd.read_csv(influencers_csv_path, sep=",", encoding='utf-8', engine='python')
        influencers_df.dropna(inplace=True)
        logging.info(f"Loaded and cleaned influencers data: {influencers_df.shape[0]} rows")

        if max_users:
            influencers_df = influencers_df.head(max_users)
            logging.info(f"Limited influencers data to {max_users} users")

    except FileNotFoundError as e:
        logging.error(f"Could not find influencers.csv file: {e}")
        return None

    all_posts = []
    user_count = 0
    for root, dirs, files in os.walk(clustered_data_path):
        if max_users and user_count >= max_users:
            break

        for dir in dirs:
            if max_users and user_count >= max_users:
                break

            username = dir
            user_count += 1

            for filename in tqdm(os.listdir(os.path.join(root, dir)), desc=f"Processing posts from user {username}"):
                if filename.endswith(".info"):
                    file_path = os.path.join(root, dir, filename)
                    post_data = extract_post_data(file_path)
                    if post_data:
                        post_data['username'] = username
                        all_posts.append(post_data)

    logging.info(f"Extracted data from {len(all_posts)} posts from {user_count} users")

    posts_df = pd.DataFrame(all_posts)

    # --- Enhanced Cleaning and Conversion for Merge ---
    influencers_df['Username'] = influencers_df['Username'].astype(str).str.strip().str.lower()
    posts_df['username'] = posts_df['username'].astype(str).str.strip().str.lower()

    # Print unique usernames for debugging
    print("Unique usernames in posts_df:")
    print(posts_df['username'].unique())
    print("\nUnique Usernames in influencers_df:")
    print(influencers_df['Username'].unique())


    final_df = pd.DataFrame()
    for i in tqdm(range(0, len(all_posts), chunk_size), desc="Processing data in chunks"):
        chunk = all_posts[i:i + chunk_size]
        posts_chunk_df = pd.DataFrame(chunk)

        if not posts_chunk_df.empty:
            posts_chunk_df = posts_chunk_df.explode('hashtags', ignore_index=True)

        # Merge on 'username'
        merged_chunk_df = pd.merge(posts_chunk_df, influencers_df, left_on='username', right_on='Username', how='left')
        if merged_chunk_df.empty:  # Check if merged DataFrame is empty
            logging.warning(f"Merged chunk DataFrame is empty for chunk {i // chunk_size}. Check merge keys.")
            continue 
        
        merged_chunk_df = merged_chunk_df.loc[:, ~merged_chunk_df.columns.duplicated()]  # Drop duplicate columns
        merged_chunk_df = merged_chunk_df.explode('comments', ignore_index=True)


        if not merged_chunk_df['comments'].isnull().all():
            merged_chunk_df = pd.concat([merged_chunk_df.drop(['comments'], axis=1), merged_chunk_df['comments'].apply(pd.Series)], axis=1)

        final_df = pd.concat([final_df, merged_chunk_df], ignore_index=True)

    
    if final_df.empty:
        logging.warning("Final DataFrame is empty after merge. No matches found.")

    logging.info(f"Finished processing. Final DataFrame shape: {final_df.shape}")
    return final_df


 "cells": [
  {
   "cell_type": "markdown",
   "source": [
    "# Instagram Engagement Predictor\n",
    "\n",
    "This notebook trains a suite of machine learning models to predict various engagement metrics for Instagram posts, including engagement rate, comment count, and sentiment."
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 1. Setup: Install and Import Libraries\n",
    "\n",
    "First, we install all the necessary libraries and import them into our environment."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Install required libraries\n",
    "!pip install transformers torch lightgbm xgboost scikit-learn pandas numpy matplotlib seaborn tensorflow -q"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import torch\n",
    "from transformers import pipeline, AutoTokenizer, AutoModel\n",
    "from sklearn.model_selection import train_test_split, cross_val_score\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier, GradientBoostingRegressor, GradientBoostingClassifier\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score, accuracy_score, precision_score, recall_score, f1_score\n",
    "from xgboost import XGBRegressor, XGBClassifier\n",
    "from lightgbm import LGBMRegressor, LGBMClassifier\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, Dropout\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 2. Initialization: Load Models and Tokenizers\n",
    "\n",
    "We initialize the pre-trained models from Hugging Face for sentiment, emotion, and text embeddings (BERT). This is done once to avoid reloading them repeatedly."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Initialize BERT tokenizer and model\n",
    "tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n",
    "bert_model = AutoModel.from_pretrained(\"bert-base-uncased\")\n",
    "device = 0 if torch.cuda.is_available() else -1\n",
    "if device == 0:\n",
    "    bert_model = bert_model.to('cuda')\n",
    "\n",
    "# Initialize sentiment and emotion pipelines\n",
    "sentiment_pipeline = pipeline(\"sentiment-analysis\", model=\"cardiffnlp/twitter-roberta-base-sentiment-latest\", device=device)\n",
    "emotion_pipeline = pipeline(\"text-classification\", model=\"j-hartmann/emotion-english-distilroberta-base\", device=device)"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 3. Helper Functions\n",
    "\n",
    "These functions encapsulate the logic for sentiment analysis and for generating BERT embeddings from text."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Sentiment and Emotion Analysis Functions\n",
    "def analyze_text(text):\n",
    "    sentiment = sentiment_pipeline(text, truncation=True, max_length=512)[0]\n",
    "    emotion = emotion_pipeline(text, truncation=True, max_length=512)[0]\n",
    "    return sentiment, emotion\n",
    "\n",
    "def get_sentiment_features(caption):\n",
    "    sentiment, emotion = analyze_text(caption)\n",
    "    sentiment_label_mapping = {'LABEL_0': 'negative', 'LABEL_1': 'neutral', 'LABEL_2': 'positive'}\n",
    "    sentiment_label = sentiment_label_mapping.get(sentiment['label'], 'neutral')\n",
    "    \n",
    "    sentiment_to_numeric = {'negative': -1, 'neutral': 0, 'positive': 1}\n",
    "    sentiment_value = sentiment_to_numeric.get(sentiment_label, 0)\n",
    "    effective_sentiment = sentiment_value * sentiment['score']\n",
    "    \n",
    "    return {\n",
    "        'caption_effective_sentiment': effective_sentiment,\n",
    "        'caption_ml_sentiment': sentiment_label,\n",
    "        'caption_sentiment_score': sentiment['score'],\n",
    "        'caption_emotion': emotion['label'],\n",
    "        'caption_emotion_score': emotion['score']\n",
    "    }\n",
    "\n",
    "# Function to get BERT embeddings\n",
    "def get_bert_embeddings(texts):\n",
    "    embeddings = []\n",
    "    for text in texts:\n",
    "        if not text or pd.isna(text):\n",
    "            embeddings.append(np.zeros(768))\n",
    "            continue\n",
    "        inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, padding=True, max_length=512)\n",
    "        if device == 0:\n",
    "            inputs = {k: v.to('cuda') for k, v in inputs.items()}\n",
    "        with torch.no_grad():\n",
    "            outputs = bert_model(**inputs)\n",
    "        embedding = outputs.last_hidden_state[:, 0, :].cpu().numpy().flatten()\n",
    "        embeddings.append(embedding)\n",
    "    return np.array(embeddings)"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 4. Data Loading and Preprocessing\n",
    "\n",
    "Load the dataset from a CSV file, handle missing values, and encode categorical variables into a numerical format suitable for machine learning."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Load the dataset\n",
    "# You need to upload \"sample_dataset.csv\" to your Colab environment\n",
    "try:\n",
    "    data = pd.read_csv('sample_dataset.csv')\n",
    "except FileNotFoundError:\n",
    "    print('Error: sample_dataset.csv not found. Please upload the file.')\n",
    "    data = pd.DataFrame() # Create empty dataframe to avoid further errors\n",
    "\n",
    "if not data.empty:\n",
    "    # Data Preprocessing\n",
    "    data = data.fillna({'caption': '', 'hashtags': '', 'location': '', 'comment_owner_username': ''})\n",
    "\n",
    "    # Encode categorical variables\n",
    "    le_media_type = LabelEncoder()\n",
    "    data['media_type_encoded'] = le_media_type.fit_transform(data['media_type'])\n",
    "    le_category = LabelEncoder()\n",
    "    data['category_encoded'] = le_category.fit_transform(data['Category'])\n",
    "    le_sentiment = LabelEncoder()\n",
    "    data['caption_ml_sentiment_encoded'] = le_sentiment.fit_transform(data['caption'].apply(lambda x: get_sentiment_features(x)['caption_ml_sentiment']))\n",
    "    le_emotion = LabelEncoder()\n",
    "    data['caption_emotion_encoded'] = le_emotion.fit_transform(data['caption'].apply(lambda x: get_sentiment_features(x)['caption_emotion']))"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 5. Feature Engineering\n",
    "\n",
    "Create new features from the existing data. This includes combining text fields, generating TF-IDF and BERT embeddings, and calculating sentiment-based features."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "if not data.empty:\n",
    "    # Combine caption and hashtags for text features\n",
    "    data['text_combined'] = data['caption'] + ' ' + data['hashtags']\n",
    "\n",
    "    # Get BERT embeddings for combined text\n",
    "    bert_embeddings = get_bert_embeddings(data['text_combined'])\n",
    "    bert_df = pd.DataFrame(bert_embeddings, columns=[f'bert_{i}' for i in range(bert_embeddings.shape[1])])\n",
    "    data = pd.concat([data.reset_index(drop=True), bert_df.reset_index(drop=True)], axis=1)\n",
    "\n",
    "    # Extract TF-IDF features\n",
    "    tfidf = TfidfVectorizer(max_features=500, stop_words='english')\n",
    "    tfidf_matrix = tfidf.fit_transform(data['text_combined'])\n",
    "    tfidf_df = pd.DataFrame(tfidf_matrix.toarray(), columns=tfidf.get_feature_names_out())\n",
    "    data = pd.concat([data.reset_index(drop=True), tfidf_df.reset_index(drop=True)], axis=1)\n",
    "\n",
    "    # Apply sentiment and emotion analysis\n",
    "    sentiment_features = data['caption'].apply(get_sentiment_features)\n",
    "    sentiment_df = pd.DataFrame(sentiment_features.tolist())\n",
    "    data = pd.concat([data.reset_index(drop=True), sentiment_df.reset_index(drop=True)], axis=1)\n",
    "\n",
    "    # Calculate sentiment-weighted engagement\n",
    "    data['sentiment_weighted_engagement'] = data['comments_count'] * data['comments_sentiment_score']"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 6. Model Training\n",
    "\n",
    "Define the features and target variables, split the data into training and testing sets, and train various regression and classification models."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "if not data.empty:\n",
    "    # Select features and targets\n",
    "    features = ['#Followers', '#Followees', '#Posts', 'media_type_encoded', 'category_encoded', \n",
    "                'caption_length', 'num_hashtags', 'has_emoji', 'has_mention', 'has_url',\n",
    "                'caption_effective_sentiment', 'caption_sentiment_score', 'caption_emotion_score',\n",
    "                'caption_ml_sentiment_encoded', 'caption_emotion_encoded'] + \n",
    "               [f'bert_{i}' for i in range(bert_embeddings.shape[1])] + \n",
    "               list(tfidf.get_feature_names_out())\n",
    "    X = data[features]\n",
    "    y_engagement = data['engagement_rate']\n",
    "    y_comments = data['comments_count']\n",
    "    y_sentiment = data['comments_sentiment'].map({'Positive': 1, 'Neutral': 0, 'Negative': -1})\n",
    "    y_weighted_engagement = data['sentiment_weighted_engagement']\n",
    "\n",
    "    # Split data\n",
    "    X_train, X_test, y_engagement_train, y_engagement_test = train_test_split(X, y_engagement, test_size=0.2, random_state=42)\n",
    "    _, _, y_comments_train, y_comments_test = train_test_split(X, y_comments, test_size=0.2, random_state=42)\n",
    "    _, _, y_sentiment_train, y_sentiment_test = train_test_split(X, y_sentiment, test_size=0.2, random_state=42)\n",
    "    _, _, y_weighted_engagement_train, y_weighted_engagement_test = train_test_split(X, y_weighted_engagement, test_size=0.2, random_state=42)\n",
    "\n",
    "    # Scale features\n",
    "    scaler = StandardScaler()\n",
    "    X_train_scaled = scaler.fit_transform(X_train)\n",
    "    X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "    # Define Neural Network for regression\n",
    "    def build_nn_regressor(input_dim):\n",
    "        model = Sequential([\n",
    "            Dense(128, activation='relu', input_dim=input_dim),\n",
    "            Dropout(0.2),\n",
    "            Dense(64, activation='relu'),\n",
    "            Dropout(0.2),\n",
    "            Dense(32, activation='relu'),\n",
    "            Dense(1)\n",
    "        ])\n",
    "        model.compile(optimizer='adam', loss='mse')\n",
    "        return model\n",
    "\n",
    "    # Define Neural Network for classification\n",
    "    def build_nn_classifier(input_dim):\n",
    "        model = Sequential([\n",
    "            Dense(128, activation='relu', input_dim=input_dim),\n",
    "            Dropout(0.2),\n",
    "            Dense(64, activation='relu'),\n",
    "            Dropout(0.2),\n",
    "            Dense(32, activation='relu'),\n",
    "            Dense(3, activation='softmax')\n",
    "        ])\n",
    "        model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
    "        return model"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 7. Evaluation\n",
    "\n",
    "Evaluate the performance of each model using standard metrics for regression (RMSE, MAE, R²) and classification (Accuracy, Precision, Recall, F1-score)."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "if not data.empty:\n",
    "    # Model Training and Evaluation\n",
    "    def evaluate_regression(y_true, y_pred, model_name):\n",
    "        rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "        mae = mean_absolute_error(y_true, y_pred)\n",
    "        r2 = r2_score(y_true, y_pred)\n",
    "        return {'Model': model_name, 'RMSE': rmse, 'MAE': mae, 'R²': r2}\n",
    "\n",
    "    def evaluate_classification(y_true, y_pred, model_name):\n",
    "        accuracy = accuracy_score(y_true, y_pred)\n",
    "        precision = precision_score(y_true, y_pred, average='weighted', zero_division=0)\n",
    "        recall = recall_score(y_true, y_pred, average='weighted', zero_division=0)\n",
    "        f1 = f1_score(y_true, y_pred, average='weighted', zero_division=0)\n",
    "        return {'Model': model_name, 'Accuracy': accuracy, 'Precision': precision, 'Recall': recall, 'F1': f1}\n",
    "\n",
    "    # Train and evaluate regression models\n",
    "    models_reg = {\n",
    "        'Linear Regression': LinearRegression(),\n",
    "        'Random Forest': RandomForestRegressor(n_estimators=100, random_state=42),\n",
    "        'Gradient Boosting': GradientBoostingRegressor(random_state=42),\n",
    "        'XGBoost': XGBRegressor(random_state=42),\n",
    "        'LightGBM': LGBMRegressor(random_state=42),\n",
    "        'Neural Network': build_nn_regressor(X_train_scaled.shape[1])\n",
    "    }\n",
    "\n",
    "    results_reg = []\n",
    "    print(\"Engagement Rate Prediction:\")\n",
    "    for name, model in models_reg.items():\n",
    "        if name == 'Neural Network':\n",
    "            model.fit(X_train_scaled, y_engagement_train, epochs=50, batch_size=32, verbose=0)\n",
    "            y_pred = model.predict(X_test_scaled).flatten()\n",
    "        else:\n",
    "            model.fit(X_train_scaled, y_engagement_train)\n",
    "            y_pred = model.predict(X_test_scaled)\n",
    "        results_reg.append(evaluate_regression(y_engagement_test, y_pred, name))\n",
    "\n",
    "    print("\nComment Count Prediction:")\n",
    "    for name, model in models_reg.items():\n",
    "        if name == 'Neural Network':\n",
    "            model = build_nn_regressor(X_train_scaled.shape[1])  # Rebuild to avoid overfitting\n",
    "            model.fit(X_train_scaled, y_comments_train, epochs=50, batch_size=32, verbose=0)\n",
    "            y_pred = model.predict(X_test_scaled).flatten()\n",
    "        else:\n",
    "            model.fit(X_train_scaled, y_comments_train)\n",
    "            y_pred = model.predict(X_test_scaled)\n",
    "        results_reg.append(evaluate_regression(y_comments_test, y_pred, name))\n",
    "\n",
    "    print("\nSentiment-Weighted Engagement Prediction:")\n",
    "    for name, model in models_reg.items():\n",
    "        if name == 'Neural Network':\n",
    "            model = build_nn_regressor(X_train_scaled.shape[1])  # Rebuild to avoid overfitting\n",
    "            model.fit(X_train_scaled, y_weighted_engagement_train, epochs=50, batch_size=32, verbose=0)\n",
    "            y_pred = model.predict(X_test_scaled).flatten()\n",
    "        else:\n",
    "            model.fit(X_train_scaled, y_weighted_engagement_train)\n",
    "            y_pred = model.predict(X_test_scaled)\n",
    "        results_reg.append(evaluate_regression(y_weighted_engagement_test, y_pred, name))\n",
    "\n",
    "    # Train and evaluate classification models\n",
    "    models_clf = {\n",
    "        'Random Forest Classifier': RandomForestClassifier(n_estimators=100, random_state=42),\n",
    "        'Gradient Boosting Classifier': GradientBoostingClassifier(random_state=42),\n",
    "        'XGBoost Classifier': XGBClassifier(random_state=42),\n",
    "        'LightGBM Classifier': LGBMClassifier(random_state=42),\n",
    "        'Neural Network Classifier': build_nn_classifier(X_train_scaled.shape[1])\n",
    "    }\n",
    "\n",
    "    results_clf = []\n",
    "    print("\nSentiment Prediction:")\n",
    "    for name, model in models_clf.items():\n",
    "        if name == 'Neural Network Classifier':\n",
    "            model.fit(X_train_scaled, y_sentiment_train + 1, epochs=50, batch_size=32, verbose=0)  # Shift labels to 0,1,2\n",
    "            y_pred = np.argmax(model.predict(X_test_scaled), axis=1) - 1\n",
    "        else:\n",
    "            model.fit(X_train_scaled, y_sentiment_train)\n",
    "            y_pred = model.predict(X_test_scaled)\n",
    "        results_clf.append(evaluate_classification(y_sentiment_test, y_pred, name))\n",
    "\n",
    "    # Model Comparison\n",
    "    results_reg_df = pd.DataFrame(results_reg)\n",
    "    results_clf_df = pd.DataFrame(results_clf)\n",
    "\n",
    "    print("\nRegression Model Comparison:")\n",
    "    print(results_reg_df)\n",
    "    print("\nClassification Model Comparison:")\n",
    "    print(results_clf_df)"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 8. Visualization\n",
    "\n",
    "Visualize the model performance metrics to easily compare the results."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "if not data.empty:\n",
    "    plt.figure(figsize=(15, 10))\n",
    "\n",
    "    # RMSE Comparison for Regression\n",
    "    plt.subplot(2, 2, 1)\n",
    "    sns.barplot(x='Model', y='RMSE', data=results_reg_df[results_reg_df['Model'].isin(models_reg.keys())])\n",
    "    plt.title('RMSE Comparison for Regression Tasks')\n",

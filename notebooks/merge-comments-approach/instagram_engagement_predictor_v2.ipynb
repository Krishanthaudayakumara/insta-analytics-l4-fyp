    "    plt.title('Accuracy Comparison for Sentiment Prediction')\n",
    "    plt.xticks(rotation=45)\n",
    "\n",
    "    # R² Comparison for Regression\n",
    "    plt.subplot(2, 2, 3)\n",
    "    sns.barplot(x='Model', y='R²', data=results_reg_df[results_reg_df['Model'].isin(models_reg.keys())])\n",
    "    plt.title('R² Comparison for Regression Tasks')\n",
    "    plt.xticks(rotation=45)\n",
    "\n",
    "    # F1 Score Comparison for Classification\n",
    "    plt.subplot(2, 2, 4)\n",
    "    sns.barplot(x='Model', y='F1', data=results_clf_df)\n",
    "    plt.title('F1 Score Comparison for Sentiment Prediction')\n",
    "    plt.xticks(rotation=45)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## 9. Prediction Pipeline\n",
    "\n",
    "This function takes new user data as input, preprocesses it in the same way as the training data, and uses the best-performing models to make predictions."
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "if not data.empty:\n",
    "    # Practical Implementation: Predict for new user input\n",
    "    def predict_engagement(user_data):\n",
    "        user_df = pd.DataFrame([user_data])\n",
    "        \n",
    "        # Encode categorical variables\n",
    "        user_df['media_type_encoded'] = le_media_type.transform([user_data['media_type']])[0]\n",
    "        user_df['category_encoded'] = le_category.transform([user_data['Category']])[0]\n",
    "        \n",
    "        # Sentiment and emotion features\n",
    "        sentiment_features = get_sentiment_features(user_data['caption'])\n",
    "        user_df['caption_effective_sentiment'] = sentiment_features['caption_effective_sentiment']\n",
    "        user_df['caption_sentiment_score'] = sentiment_features['caption_sentiment_score']\n",
    "        user_df['caption_emotion_score'] = sentiment_features['caption_emotion_score']\n",
    "        user_df['caption_ml_sentiment_encoded'] = le_sentiment.transform([sentiment_features['caption_ml_sentiment']])[0]\n",
    "        user_df['caption_emotion_encoded'] = le_emotion.transform([sentiment_features['caption_emotion']])[0]\n",
    "        \n",
    "        # Combine text features\n",
    "        user_df['text_combined'] = user_df['caption'] + ' ' + user_df['hashtags']\n",
    "        \n",
    "        # Get BERT embeddings\n",
    "        user_bert = get_bert_embeddings([user_df['text_combined'].iloc[0]])\n",
    "        user_bert_df = pd.DataFrame(user_bert, columns=[f'bert_{i}' for i in range(user_bert.shape[1])])\n",
    "        \n",
    "        # TF-IDF transformation\n",
    "        user_tfidf = tfidf.transform(user_df['text_combined'])\n",
    "        user_tfidf_df = pd.DataFrame(user_tfidf.toarray(), columns=tfidf.get_feature_names_out())\n",
    "        \n",
    "        # Prepare features\n",
    "        user_features = pd.concat([user_df[['#Followers', '#Followees', '#Posts', 'media_type_encoded', 'category_encoded', \n",
    "                                           'caption_length', 'num_hashtags', 'has_emoji', 'has_mention', 'has_url',\n",
    "                                           'caption_effective_sentiment', 'caption_sentiment_score', 'caption_emotion_score',\n",
    "                                           'caption_ml_sentiment_encoded', 'caption_emotion_encoded']].reset_index(drop=True), \n",
    "                                  user_bert_df.reset_index(drop=True), user_tfidf_df.reset_index(drop=True)], axis=1)\n",
    "        \n",
    "        user_features_scaled = scaler.transform(user_features)\n",
    "        \n",
    "        # Select best models (based on R² for regression, F1 for classification)\n",
    "        engagement_model = models_reg['LightGBM']\n",
    "        comments_model = models_reg['LightGBM']\n",
    "        sentiment_model = models_clf['LightGBM Classifier']\n",
    "        weighted_model = models_reg['LightGBM']\n",
    "        \n",
    "        engagement_pred = engagement_model.predict(user_features_scaled)[0]\n",
    "        comments_pred = comments_model.predict(user_features_scaled)[0]\n",
    "        sentiment_pred = sentiment_model.predict(user_features_scaled)[0]\n",
    "        weighted_pred = weighted_model.predict(user_features_scaled)[0]\n",
    "        \n",
    "        sentiment_map = {1: 'Positive', 0: 'Neutral', -1: 'Negative'}\n",
    "        \n",
    "        return {\n",
    "            'Engagement Rate': engagement_pred,\n",
    "            'Comment Count': comments_pred,\n",
    "            'Comment Sentiment': sentiment_map[sentiment_pred],\n",
    "            'Sentiment-Weighted Engagement': weighted_pred\n",
    "        }
"
   ]
  },
  {
   "cell_type": "markdown",
